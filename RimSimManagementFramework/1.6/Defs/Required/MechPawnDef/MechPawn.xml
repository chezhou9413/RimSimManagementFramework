<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="LightMechanoid" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>RSMF_Mech_Restorer</defName>
        <label>补货机</label>
        <description>一台小型的补货机器，用于将殖民者从繁杂的补货工作中解脱出来</description>
        <statBases>
            <MoveSpeed>5.0</MoveSpeed>
        </statBases>
        <race>
            <mechEnabledWorkTypes>
                <li>Restocking</li>
            </mechEnabledWorkTypes>
            <lifeStageAges>
                <li>
                    <def>MechanoidFullyFormed</def>
                    <minAge>0</minAge>
                    <soundWounded>Pawn_Mech_Lifter_Wounded</soundWounded>
                    <soundDeath>Pawn_Mech_Lifter_Death</soundDeath>
                    <soundCall>Pawn_Mech_Lifter_Call</soundCall>
                </li>
                <li>
                    <def>MechanoidFullyFormed</def>
                    <minAge>100</minAge>
                    <soundWounded>Pawn_Mech_Lifter_Wounded</soundWounded>
                    <soundDeath>Pawn_Mech_Lifter_Death</soundDeath>
                    <soundCall>Pawn_Mech_Lifter_Call</soundCall>
                </li>
            </lifeStageAges>
        </race>
    </ThingDef>

    <PawnKindDef ParentName="NonCombatLightMechanoidKind" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>RSMF_Mech_Restorer</defName>
        <label>补货机</label>
        <race>RSMF_Mech_Restorer</race>
        <lifeStages>
            <li>
                <bodyGraphicData>
