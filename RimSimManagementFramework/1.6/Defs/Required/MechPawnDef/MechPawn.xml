                    <maskPath>Things/Pawn/MechPawn/RSMF_Mech_Restorer/RSMF_Mech_RestorerT</maskPath>
                    <shaderType>CutoutWithOverlay</shaderType>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>1.1</drawSize>
                </bodyGraphicData>
            </li>
            <li>
                <bodyGraphicData>
                    <texPath>Things/Pawn/MechPawn/RSMF_Mech_Restorer/RSMF_Mech_Restorer</texPath>
                    <maskPath>Things/Pawn/MechPawn/RSMF_Mech_Restorer/RSMF_Mech_RestorerT</maskPath>
                    <shaderType>CutoutWithOverlay</shaderType>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>1.1</drawSize>
                </bodyGraphicData>
            </li>
