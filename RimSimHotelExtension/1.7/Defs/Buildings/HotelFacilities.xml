<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RSH_ServiceDesk</defName><label>hotel reception desk</label>
    <description>A hotel reception and cash storage facility. Receptionists handle check-in, extensions and check-out here. Prepaid accommodation becomes revenue one night at a time; unused nights can be refunded. Each hotel uses one main reception desk.</description>
    <thingClass>RimSimHotelExtension.Buildings.Building_HotelDesk</thingClass>
    <designationCategory>SimManagementBuildings</designationCategory><uiOrder>460</uiOrder>
    <graphicData><texPath>Things/Building/CashRegister/Sim_CashRegister</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3.2,3.2)</drawSize></graphicData>
    <size>(3,1)</size><canOverlapZones>true</canOverlapZones><passability>PassThroughOnly</passability><pathCost>50</pathCost><fillPercent>0.5</fillPercent>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases><MaxHitPoints>220</MaxHitPoints><WorkToBuild>4000</WorkToBuild><Flammability>0.7</Flammability><Beauty>2</Beauty></statBases>
    <costList><WoodLog>100</WoodLog><Steel>40</Steel></costList>
    <comps><li Class="SimManagementLib.SimThingComp.CompProperties_CashStorage"><defaultWithdrawThreshold>1000</defaultWithdrawThreshold><maxWithdrawThreshold>50000</maxWithdrawThreshold></li></comps>
    <placeWorkers><li>PlaceWorker_PreventInteractionSpotOverlap</li></placeWorkers>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>RSH_Atm</defName><label>ATM</label>
    <description>Transfers money from a guest's finite travel account to their spending balance. Only withdrawal fees count as shop revenue. Requires power. Resetting the daily withdrawal limit does not create new travel funds.</description>
    <thingClass>RimSimHotelExtension.Buildings.Building_HotelAtm</thingClass>
    <designationCategory>SimManagementBuildings</designationCategory><uiOrder>461</uiOrder>
    <graphicData><texPath>Things/Building/CashRegister/Sim_CashRegisterMachine</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(1.5,1.5)</drawSize></graphicData>
    <size>(1,1)</size><canOverlapZones>true</canOverlapZones><passability>Impassable</passability><fillPercent>1</fillPercent>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-1)</interactionCellOffset><tickerType>Normal</tickerType>
    <statBases><MaxHitPoints>180</MaxHitPoints><WorkToBuild>5000</WorkToBuild><Flammability>0.4</Flammability></statBases>
    <costList><Steel>90</Steel><ComponentIndustrial>3</ComponentIndustrial></costList>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>100</basePowerConsumption></li>
      <li Class="CompProperties_Flickable" />
      <li Class="SimManagementLib.SimThingComp.CompProperties_CashStorage"><defaultWithdrawThreshold>100</defaultWithdrawThreshold><maxWithdrawThreshold>5000</maxWithdrawThreshold></li>
    </comps>
    <placeWorkers><li>PlaceWorker_PreventInteractionSpotOverlap</li></placeWorkers>
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>RSH_Locker</defName><label>apparel locker</label>
    <description>Stores one spa customer's actual apparel. Clothing is returned when bathing ends or is interrupted. Deconstructing or destroying the locker releases its contents.</description>
    <thingClass>RimSimHotelExtension.Spa.Building_HotelLocker</thingClass>
    <designationCategory>SimManagementBuildings</designationCategory><uiOrder>482</uiOrder>
    <graphicData><texPath>Things/Building/Hotel/Locker/Locker</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(1.6,1.6)</drawSize></graphicData>
    <size>(1,1)</size><canOverlapZones>true</canOverlapZones><passability>Impassable</passability><fillPercent>1</fillPercent>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases><MaxHitPoints>160</MaxHitPoints><WorkToBuild>2500</WorkToBuild><Flammability>0.7</Flammability><Beauty>1</Beauty></statBases>
    <costList><WoodLog>45</WoodLog><Steel>10</Steel></costList>
  </ThingDef>
</Defs>
