<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BenchBase">
        <defName>RSR_RestaurantOrderCounter</defName>
        <label>餐厅接待与出餐台</label>
        <description>餐厅接待与出餐设施。顾客在桌椅入座后由服务员交谈点菜；厨师把成品存入此台，服务员再整单送到顾客的私人桌面托盘。餐品在容器中独立保存，会正常腐坏。柜中现货由服务员直接配送，所有追加订单处理完毕后统一前往收银台付款。</description>
        <thingClass>RimSimRestaurantExtension.Buildings.Building_RestaurantPass</thingClass>
        <tickerType>Normal</tickerType>
        <designationCategory>SimManagementBuildings</designationCategory>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <clearBuildingArea>false</clearBuildingArea>    <!-- 不清除底下的东西 -->
        <graphicData>
            <texPath>Things/Building/Restaurant/RestaurantOrderCounter/RSR_RestaurantOrderCounter</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <size>(1,1)</size>
        <costList>
            <Steel>10</Steel>
        </costList>
        <statBases>
            <MaxHitPoints>180</MaxHitPoints>
            <WorkToBuild>1600</WorkToBuild>
            <Flammability>0.7</Flammability>
        </statBases>
        <building>
            <isEdifice>false</isEdifice>
            <canPlaceOverWall>false</canPlaceOverWall>
        </building>
  </ThingDef>

</Defs>
