    <stuffCategories><li>Woody</li><li>Metallic</li></stuffCategories><costStuffCount>35</costStuffCount>
    <passability>PassThroughOnly</passability><pathCost>30</pathCost><fillPercent>0.35</fillPercent><defaultPlacingRot>South</defaultPlacingRot>
    <statBases><MaxHitPoints>140</MaxHitPoints><WorkToBuild>5000</WorkToBuild><Mass>20</Mass><Comfort>0.65</Comfort><Beauty>4</Beauty><Flammability>1</Flammability></statBases>
    <building><isSittable>true</isSittable><multiSittable>false</multiSittable><paintable>true</paintable></building>
    <researchPrerequisites><li>ComplexFurniture</li></researchPrerequisites><constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>RSR_BoothSofa</defName><label>双人卡座沙发</label>
    <description>两个占用格可分别预约，供两名顾客独立用餐。</description>
    <thingClass>Building</thingClass><designationCategory>SimManagementBuildings</designationCategory>
    <size>(2,1)</size><altitudeLayer>Building</altitudeLayer><canOverlapZones>true</canOverlapZones>
    <graphicData><texPath>Things/Building/Restaurant/BoothSofa/RSR_BoothSofa</texPath><graphicClass>Graphic_Multi</graphicClass><shaderType>CutoutComplex</shaderType><drawSize>(4,4)</drawSize></graphicData>
    <stuffCategories><li>Fabric</li><li>Leathery</li></stuffCategories><costStuffCount>160</costStuffCount>
    <passability>PassThroughOnly</passability><pathCost>30</pathCost><fillPercent>0.35</fillPercent><defaultPlacingRot>South</defaultPlacingRot>
    <statBases><MaxHitPoints>140</MaxHitPoints><WorkToBuild>16000</WorkToBuild><Mass>20</Mass><Comfort>0.85</Comfort><Beauty>4</Beauty><Flammability>1</Flammability></statBases>
    <building><isSittable>true</isSittable><multiSittable>true</multiSittable><paintable>true</paintable></building>
    <researchPrerequisites><li>ComplexFurniture</li></researchPrerequisites><constructionSkillPrerequisite>4</constructionSkillPrerequisite>
