    <size>(1,1)</size><canOverlapZones>true</canOverlapZones><rotatable>true</rotatable>
    <graphicData><texPath>Things/Building/Restaurant/WallCabinet/RSR_WallCabinet</texPath><graphicClass>RimSimRestaurantExtension.Buildings.Graphic_RestaurantWallCabinet</graphicClass><shaderType>CutoutComplex</shaderType><drawSize>(2,2)</drawSize>
      <drawOffsetNorth>(0,0,0.65)</drawOffsetNorth><drawOffsetSouth>(0,0,-0.65)</drawOffsetSouth><drawOffsetEast>(0.65,0,0)</drawOffsetEast><drawOffsetWest>(-0.65,0,0)</drawOffsetWest>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer><drawerType>MapMeshOnly</drawerType>
    <passability>Standable</passability><pathCost>0</pathCost>
    <statBases><MaxHitPoints>180</MaxHitPoints><WorkToBuild>4000</WorkToBuild><Mass>25</Mass><Beauty>3</Beauty><Flammability>0.3</Flammability></statBases>
    <costList><Steel>60</Steel></costList>
    <building><isEdifice>false</isEdifice><isAttachment>true</isAttachment><paintable>true</paintable></building>
    <terrainAffordanceNeeded IsNull="True"/><placeWorkers><li>Placeworker_AttachedToWall</li></placeWorkers>
    <comps>
      <li Class="SimManagementLib.SimThingComp.ThingCompProperties_GoodsData"><maxTotalCapacity>300</maxTotalCapacity></li>

    </comps>
    <modExtensions><li Class="RimSimRestaurantExtension.Inventory.RestaurantStorageExtension"><refrigerated>false</refrigerated><wallMounted>true</wallMounted><products>
      <li>RSR_Beer</li><li>RSR_PreparedFood</li><li>RSR_TakeAwayGoods</li>
    </products></li></modExtensions>
  </ThingDef>
